option version = "1.0.0";

import "vnet/interface_types.api";

autoreply define qinq_interface_rule_add
{
  u32 client_index;
  u32 context;
  u32 rule_id;
  vl_api_interface_index_t sw_if_index;
  vl_api_interface_index_t parent_sw_if_index;
  u16 outer_tpid;
  u16 outer_vlan;
  u16 inner_tpid;
  u16 inner_vlan_first;
  u16 inner_vlan_last;
  u8 match_type;
  bool admin_up;
};

autoreply define qinq_interface_rule_update
{
  u32 client_index;
  u32 context;
  u32 rule_id;
  vl_api_interface_index_t sw_if_index;
  vl_api_interface_index_t parent_sw_if_index;
  u16 outer_tpid;
  u16 outer_vlan;
  u16 inner_tpid;
  u16 inner_vlan_first;
  u16 inner_vlan_last;
  u8 match_type;
  bool admin_up;
};

autoreply define qinq_interface_rule_delete
{
  u32 client_index;
  u32 context;
  u32 rule_id;
};
